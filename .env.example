# Postgres connection string used by Prisma.
DATABASE_URL=

# next-auth. NEXTAUTH_URL is the public origin, for example https://workout-tracker-jiram.vercel.app
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Public origin used when scheduling rest-timer callbacks. Must include https://
APP_URL=

# Bearer token for /api/cron/morning
CRON_SECRET=

# Upstash QStash. Both signing keys are required; the receiver does not run in dev mode.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Web push. VAPID_SUBJECT is required (for example mailto:you@example.com). There is no fallback.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Upstash Redis for rate limiting (required in production; fail closed without these).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Forwarded to QStash so delayed callbacks can pass Vercel Deployment Protection.
VERCEL_AUTOMATION_BYPASS_SECRET=
